# Supabase project address.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Server only, never sent to the browser. The browser talks to Supabase through /api/sb.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TMDB credentials (server only). The read access token is preferred, the v3 key also works.
VITE_TMDB_FETCH_API_KEY=your-tmdb-read-access-token
VITE_TMDB_API_KEY=your-tmdb-v3-key

# Optional. When set, /api/keep-alive requires "Authorization: Bearer <secret>".
# Vercel Cron sends this header automatically.
CRON_SECRET=
